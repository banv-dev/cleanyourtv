<?xml version="1.0" encoding="utf-8"?>
<!-- Notification detail dialog: shows full app info, timestamp, full title, scrollable body, and action buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp"
    android:elevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/appName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_medium" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit" />
    </LinearLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="-0.01" />

    <ScrollView
        android:id="@+id/bodyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:focusable="false"
        android:scrollbars="vertical"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp"
            android:lineSpacingExtra="4sp"
            android:fontFamily="@font/outfit" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnDismiss"
            style="@style/TopButton"
            android:text="@string/notification_dismiss"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnOpen"
            style="@style/TopButton"
            android:text="@string/library_open"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnClose"
            style="@style/TopButton"
            android:text="@string/notification_close" />
    </LinearLayout>
</LinearLayout>

