<?xml version="1.0" encoding="utf-8"?>
<!-- Theme pictures with a stationary clock in the bottom-left corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/collectionRoot"
    android:background="#FF000000">

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_gravity="bottom|left"
        android:layout_marginBottom="32dp"
        android:layout_marginLeft="40dp"
        android:gravity="left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:shadowColor="#CC000000"
                android:shadowRadius="6"
                android:shadowDy="1"
                android:textColor="#E6FFFFFF"
                android:textSize="53.33sp"
                android:fontFamily="@string/font_extralight"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:shadowColor="#CC000000"
                android:shadowRadius="6"
                android:shadowDy="1"
                android:textColor="#99FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:shadowDy="1"
            android:textColor="#8CFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.14"
            android:textAllCaps="true" />
    </LinearLayout>
</FrameLayout>
